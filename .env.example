# App
NEXT_PUBLIC_APP_URL=http://localhost:3010

# OVH AI Endpoints — same names as clin/web
LLM_PROVIDER=ovh
LLM_MODEL=
OVH_AI_ENDPOINTS_ACCESS_TOKEN=
OVH_AI_ENDPOINTS_MODEL_URL=
OVH_AI_UNIFIED_MODEL_URL=
OVH_AI_REASONING_MODEL_LOW=
OVH_AI_REASONING_MODEL_HIGH=
OVH_AI_EMBEDDING_MODEL=
OVH_AI_REASONING_MAX_TOKENS=

# Local Supabase: fill with npm run db:sync-env
# Production cloud project: bbvpuxuvtnpfmprufgab
#   https://bbvpuxuvtnpfmprufgab.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth email is owned by Supabase Auth (not this Next.js process).
# Local → Mailpit at http://127.0.0.1:54324 (supabase start).
# Prod → npm run auth:configure-email (Supabase built-in mailer).
# Later Brevo/Resend → same script with SMTP_* (see docs/EMAIL.md).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_ADMIN_EMAIL=noreply@leblebee.com
# SMTP_SENDER_NAME=Leblebee
